APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CONTOUR_CSRF_SECRET=
# Base64 of 32 random bytes. Keep stable or existing project tokens cannot be decrypted.
CLOUD_VAULT_KEY=
CLOUD_VAULT_KEY_ID=k1
# Production defaults to cimd. Use dcr for HTTP localhost only.
CLOUD_CLIENT_MODE=dcr
# Development only. Never enable in production.
CLOUD_ALLOW_LOCAL_PROJECTS=1
