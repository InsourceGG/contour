# Copy to .env.local and fill in real values. Never commit real values.

# Existing Northwind settings
NEXT_PUBLIC_SUPABASE_URL=          # Supabase project URL
SUPABASE_SECRET_KEY=               # Service-role key, server only
NW_SESSION_SECRET=                 # At least 32 characters, signs the nw_session cookie
APP_URL=http://localhost:3200      # Public origin, no trailing slash; Contour's OAuth issuer

# Contour
CONTOUR_CSRF_SECRET=               # Strong random secret for Contour host CSRF tokens, server only
CONTOUR_CLOUD_URL=                 # Optional: Contour Cloud origin; enables the trusted Cloud client
CONTOUR_PROJECT_TOKEN=             # Optional: Cloud registration token, used only by setup, never by the app
AI_GATEWAY_API_KEY=                # Selector credential for layout proposals, server only
JEV_MODEL=typesafe-ai/jev          # Optional selector model
JEV_TIMEOUT_MS=4000                # Optional selector timeout
